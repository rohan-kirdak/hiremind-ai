# Server Configuration
PORT=5000
NODE_ENV=development

# Google Gemini API
# Get an API key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# Security & CORS
# Comma-separated list of allowed origins in production. In development, defaults to allow all.
CORS_ORIGIN=http://localhost:5173

# Rate Limiting (in-memory per client IP)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_CHAT_MAX=20
RATE_LIMIT_UPLOAD_MAX=10

# Jobs Dataset (Optional custom path, automatically resolves in monorepo if omitted)
# JOBS_DATA_PATH=../job-data-collector/jobs.json
